{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hokus.ai/schemas/provider-execution.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionRef",
    "ownershipAttemptIds",
    "responseId",
    "transport",
    "requestedModel",
    "responseModel",
    "generation"
  ],
  "properties": {
    "sessionRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ownershipAttemptIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "responseId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "transport": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requestedModel": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "responseModel": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["totalCostUsd"],
      "properties": {
        "totalCostUsd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "providerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "modelPermaslug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cacheDiscountUsd": {
          "type": "number",
          "minimum": 0
        },
        "nativeTokensPrompt": {
          "type": "number",
          "minimum": 0
        },
        "nativeTokensCached": {
          "type": "number",
          "minimum": 0
        },
        "nativeTokensCompletion": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "requestedRouting": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "only": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "ignore": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "quantizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allow_fallbacks": {
          "type": "boolean"
        },
        "require_parameters": {
          "type": "boolean"
        }
      }
    },
    "pricingSnapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["scope", "inputCostPerMTok", "outputCostPerMTok"],
      "properties": {
        "scope": {
          "enum": ["model", "endpoint"]
        },
        "inputCostPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "outputCostPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "cacheReadCostPerMTok": {
          "type": "number",
          "minimum": 0
        },
        "cacheWriteCostPerMTok": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "reasoning_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "output_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cache_write_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "observationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "transport": {
            "const": "openrouter"
          }
        }
      }
    }
  ]
}
